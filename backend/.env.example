APP_NAME=LabNote API
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8110
APP_SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SYSTEM_ADMIN_PASSWORD=change-this-admin-password

# [DATABASE CONFIG]
DB=sqlite
DB_NAME=storage/labnote.db

STORAGE_ROOT=./storage

# Optional override
# DATABASE_URL=sqlite:///storage/labnote.db

# [LLM CONFIG] - AI note draft generation (leave OPENAI_API_KEY empty to disable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_PAGES=4

# Prefer the institution's Platform integrations screen for CliProxy settings.
# Example legacy configuration: OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# OPENAI_MODEL=<model ID returned by CliProxy /v1/models>
# OPENAI_API_KEY=<CliProxy client API key, not the management key>
LLM_JSON_MODE=true
LLM_BATCH_MAX_ITEMS=100
# Optional Fernet key. If empty, backend/.llm-encryption.key is generated locally.
# Keep this key with your backups; changing it requires re-entering saved API keys.
LLM_ENCRYPTION_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────
# Public URL of this API; GitHub delivers webhooks to it (e.g. https://labnote.example.com/api).
PUBLIC_API_BASE_URL=
# GitHub App (recommended). Create one at GitHub → Settings → Developer settings → GitHub Apps:
#   Permissions (Repository): Contents: Read, Metadata: Read, Pull requests: Read
#   Subscribe to events: Push, Pull request
#   Webhook URL:  <PUBLIC_API_BASE_URL>/github/app/webhook   (Webhook secret = GITHUB_APP_WEBHOOK_SECRET)
#   Setup URL:    <frontend URL>/   (check "Redirect on update")
#   Callback URL: <frontend URL>/   (for "GitHub로 로그인" that links each user's GitHub account)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
